# JARVIS - Beispiel-Konfiguration. Kopieren nach .env und eigene Werte setzen.
# KEINE echten Werte committen (.env steht in .gitignore).

# Gaming-PC (Rechenknoten)
PC_HOST=192.168.1.100           # IP des Gaming-PCs im eigenen Netz
PC_WOL_MAC=AA:BB:CC:DD:EE:FF    # MAC fuer Wake-on-LAN
PC_OLLAMA_PORT=11434            # Modell-Endpunkt auf dem PC

# Modelle (Ollama)
SMALL_MODEL=qwen2.5:3b          # kleines Modell auf dem Laptop
LARGE_MODEL=qwen2.5:14b         # grosses Modell auf dem Gaming-PC

# Dienste / Ports
PROXY_PORT=11435
VOICE_PORT=11436

# Push-Benachrichtigung (ntfy)
NTFY_URL=http://127.0.0.1:8180/
NTFY_TOPIC=                     # eigenes, nicht erratbares Thema setzen
