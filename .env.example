# JARVIS - Beispiel-Konfiguration. Kopieren nach .env und eigene Werte setzen.
# JARVIS - example configuration. Copy to .env and set your own values.
# KEINE echten Werte committen (.env steht in .gitignore).
# Do NOT commit real values (.env is in .gitignore).

# Gaming-PC (Rechenknoten) / Gaming PC (compute node)
PC_HOST=192.168.1.100           # IP des Gaming-PCs im eigenen Netz / IP of the gaming PC in your own network
PC_WOL_MAC=AA:BB:CC:DD:EE:FF    # MAC fuer Wake-on-LAN / MAC address for Wake-on-LAN
PC_OLLAMA_PORT=11434            # Modell-Endpunkt auf dem PC / model endpoint on the PC

# Modelle (Ollama) / Models (Ollama)
SMALL_MODEL=granite4:3b         # kleines Modell auf dem Laptop / small model on the laptop
LARGE_MODEL=gemma4:26b          # grosses Modell auf dem Gaming-PC / large model on the gaming PC

# Dienste / Ports / Services / ports
PROXY_PORT=11435
VOICE_PORT=11436

# Push-Benachrichtigung (ntfy) / Push notification (ntfy)
NTFY_URL=http://127.0.0.1:8180/
NTFY_TOPIC=                     # eigenes, nicht erratbares Thema setzen / set your own, unguessable topic
