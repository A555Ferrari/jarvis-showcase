[Unit]
Description=JARVIS Tunnel zum Gaming-PC (STT 18765 -> 8765, ComfyUI 18188 -> 8188)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -i /root/.ssh/n8n_wol_key_rsa -o IdentitiesOnly=yes -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -o ConnectTimeout=5 -L 127.0.0.1:18765:127.0.0.1:8765 -L 127.0.0.1:18188:127.0.0.1:8188 user@192.168.1.100
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
